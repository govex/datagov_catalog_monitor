# list_cache_files.yml
name: List Cache Files

on:
  workflow_dispatch:  # Allows manual triggering

jobs:
  list-files:
    runs-on: ubuntu-latest
    env:
      DATA_CACHE_DIR: data

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.12'

      - name: Cache data directory
        uses: actions/cache@v3
        with:
          path: ${{ env.DATA_CACHE_DIR }}
          key: ${{ runner.os }}-data-cache
          restore-keys: |
            ${{ runner.os }}-data-

      - name: Run list files script
        env:
          DATA_CACHE_DIR: ${{ env.DATA_CACHE_DIR }}
        run: python scripts/list_cache_files.py

